{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@mark1russell7/cue/ts/config/react.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "allowImportingTsExtensions": true,
    "rootDir": "${configDir}"
  },
  // The site, the build scripts and the configs. tsconfig.test.json checks the tests.
  "include": ["src/**/*", "scripts/**/*", "*.config.ts"]
}
