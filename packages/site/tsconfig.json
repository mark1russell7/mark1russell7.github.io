{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@mark1russell7/cue/ts/config/react.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "allowImportingTsExtensions": true,
    "rootDir": "${configDir}"
  },
  // Every .ts file of the package: the site, its tests, the build scripts and the configs (the fail-closed audit of 10-30).
  "include": ["src/**/*", "scripts/**/*", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
